model Quotation {
  id          String          @id @default(uuid())
  proposedFee Decimal         @db.Decimal(10, 2)
  status      QuotationStatus @default(PENDING)

  requestId String
  request   WorkRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  staffId String
  staff   User   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  selectedFor WorkRequest? @relation("SelectedQuotation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, staffId])
  @@index([staffId])
  @@map("quotations")
}
