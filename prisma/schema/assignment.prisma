model Assignment {
  id String @id @default(uuid())

  status AssignmentStatus @default(ONGOING)

  amount Decimal @db.Decimal(10, 2)

  advanceAmount Decimal @db.Decimal(10, 2)

  requestId String
  request   WorkRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  staffId String
  staff   User   @relation("StaffAssignments", fields: [staffId], references: [id], onDelete: Cascade)

  citizenId String
  citizen   User   @relation("CitizenAssignments", fields: [citizenId], references: [id], onDelete: Cascade)

  attachments WorkAttachment[]
  feedbacks   Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId])
  @@index([staffId])
  @@index([citizenId])
  @@map("assignments")
}
