model WorkAttachment {
  id           String  @id @default(uuid())
  assignmentId String
  fileUrl      String
  publicId     String
  resourceType String
  fileType     String?
  fileName     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([assignmentId])
  @@map("attachments")
}