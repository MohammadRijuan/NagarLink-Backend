model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String?

  needPasswordChange Boolean @default(false)
  emailVerified      Boolean @default(false)

  googleId     String?      @unique
  authProvider AuthProvider @default(CREDENTIAL)

  phone      String?
  role       Role      @default(CITIZEN)
  division   String?
  district   String?
  address    String?
  postalCode String?
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?

  staffApplications  StaffApplication[]
  staffCategories    StaffCategory[]
  staffLocation      StaffLocation[]
  workRequest        WorkRequest[]
  quotations         Quotation[]
  staffAssignments   Assignment[]       @relation("StaffAssignments")
  citizenAssignments Assignment[]       @relation("CitizenAssignments")
  feedbacks          Feedback[]
  staffInvitations   StaffInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
