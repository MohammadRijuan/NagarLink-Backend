model Payment {
  id String @id @default(uuid())

  status PaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  paymentGateway        String @default("sslcommerz")
  merchantInvoiceNumber String @unique

  paidAt         DateTime?
  gatewayResponse Json?

  refundTrxId  String?
  refundAmount Decimal?  @db.Decimal(10, 2)
  refundReason String?
  refundedAt   DateTime?

  requestId String
  request   WorkRequest @relation(fields: [requestId], references: [id], onUpdate: Cascade)

  sslcommerzPayment SslCommerzPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([status])
  @@map("payments")
}

model SslCommerzPayment {
  id String @id @default(uuid())

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  tranId String @unique

  bankTranId String?
  valId      String?

  cardType   String?
  cardIssuer String?
  cardBrand  String?
  cardIssuerCountry String?

  storeAmount Decimal? @db.Decimal(10, 2)

  gatewayResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tranId])
  @@map("sslcommerz_payments")
}