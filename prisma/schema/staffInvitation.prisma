model StaffInvitation {
  id           String           @id @default(uuid())
  requestId    String
  staffId      String
  status       InvitationStatus @default(REQUESTED)
  responseNote String?

  request WorkRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  staff   User        @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, staffId])
  @@index([requestId])
  @@index([staffId])
  @@map("staff_invitations")
}
