model WorkRequest {
  id          String     @id @default(uuid())
  title       String
  description String
  division    String
  city        String
  address     String
  postalCode  String
  phone       String
  approvedFee Decimal?   @db.Decimal(10, 2)
  status      WorkStatus @default(PENDING)

  rejectionReason String?

  citizenId String
  citizen   User   @relation(fields: [citizenId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  selectedQuotationId String?    @unique
  selectedQuotation   Quotation? @relation("SelectedQuotation", fields: [selectedQuotationId], references: [id], onDelete: SetNull)

  quotations       Quotation[]
  staffInvitations StaffInvitation[]
  payments         Payment[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  assignment Assignment?

  @@index([citizenId])
  @@index([status])
  @@map("work_requests")
}
