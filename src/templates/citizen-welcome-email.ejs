<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to NagarLink</title>
</head>

<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f7fb;">

  <div style="max-width: 600px; margin: 30px auto; background: #ffffff; border-radius: 10px; overflow: hidden;">

    <!-- Header -->
    <div style="background-color: #2563eb; padding: 25px; text-align: center; color: white;">
      <h1 style="margin: 0;">Welcome to NagarLink!</h1>
    </div>

    <!-- Body -->
    <div style="padding: 30px; color: #333333;">

      <h2>Hello <%= name %>,</h2>

      <p>
        Your citizen account has been successfully created.
        We are delighted to have you join NagarLink.
      </p>

      <p>
        NagarLink helps citizens connect with municipal services,
        submit complaints, track service requests, and stay informed
        about community updates.
      </p>

      <p>Best regards,<br><strong>NagarLink Team</strong></p>

    </div>

    <!-- Footer -->
    <div style="background-color: #f1f5f9; padding: 15px; text-align: center; color: #64748b; font-size: 12px;">
      &copy; <%= new Date().getFullYear() %> NagarLink. All rights reserved.
    </div>

  </div>

</body>
</html>