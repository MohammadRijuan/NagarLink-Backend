 
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Email Verification - NagarLink</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6f9; font-family:Arial,Helvetica,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 15px; background-color:#f4f6f9;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" style="max-width:500px; background:#ffffff; border-radius:12px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td style="background:#166534; padding:25px; text-align:center;">
              <h1 style="margin:0; color:#ffffff; font-size:26px;">NagarLink</h1>
              <p style="margin:8px 0 0; color:#dcfce7; font-size:13px;">
                Connecting Citizens, Building Communities
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:35px 30px; color:#333333;">
              <h2 style="margin:0 0 15px; font-size:22px; color:#111827;">
                Verify Your Email Address
              </h2>

              <p style="font-size:15px; line-height:1.7; color:#4b5563;">
                Hello <strong><%= name %></strong>,
              </p>

              <p style="font-size:15px; line-height:1.7; color:#4b5563;">
                Thank you for registering with NagarLink. To complete your registration, please use the verification code below.
              </p>

              <!-- OTP -->
              <div style="margin:30px 0; padding:22px; text-align:center; background:#f0fdf4; border:1px dashed #16a34a; border-radius:8px;">
                <p style="margin:0 0 10px; font-size:12px; color:#64748b; text-transform:uppercase; letter-spacing:2px;">
                  Your verification code
                </p>

                <h1 style="margin:0; font-size:34px; letter-spacing:8px; color:#166534;">
                  <%= otp %>
                </h1>
              </div>

              <p style="font-size:14px; line-height:1.7; color:#4b5563;">
                This verification code will expire in <strong>5 minutes</strong>.
              </p>

              <p style="font-size:14px; line-height:1.7; color:#4b5563;">
                If you did not create a NagarLink account, you can safely ignore this email.
              </p>

              <p style="margin-top:30px; font-size:14px; color:#4b5563;">
                Best regards,<br>
                <strong style="color:#166534;">NagarLink Team</strong>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:20px; text-align:center; background:#f9fafb; border-top:1px solid #e5e7eb;">
              <p style="margin:0; font-size:12px; color:#9ca3af;">
                © <%= new Date().getFullYear() %> NagarLink. All rights reserved.
              </p>
              <p style="margin:8px 0 0; font-size:11px; color:#9ca3af;">
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>